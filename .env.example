APP_NAME="GPS Product Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
PUBLIC_STORAGE_URL=${APP_URL}/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WORKSHOP_INTAKE_NOTIFICATION_EMAIL=
WORKSHOP_INTAKE_MAIL_ATTACHMENTS_MAX_MB=20

GPS_INTEGRATIONS_ENABLED=false
GPS_WOO_WRITES_ENABLED=false
GPS_MARKETPLACE_PUBLISHING_ENABLED=false
GPS_EXTERNAL_API_WRITES_ENABLED=false
GPS_EBAY_PUBLISHING_ENABLED=false
GPS_ALLEGRO_PUBLISHING_ENABLED=false
GPS_OVOKO_PUBLISHING_ENABLED=false
GPS_ALLEGRO_INTEGRATION_ENABLED=false
GPS_OVOKO_INTEGRATION_ENABLED=false
# Legacy fallback used only when GPS_* publishing flags are absent.
MARKETPLACE_PUBLISH_ENABLED=false
GPS_NBP_RATES_ENABLED=false

PRODUCT_IMAGES_DRY_RUN_TOKEN=
PRODUCT_IMAGES_IMPORT_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

FRONTEND_MAINTENANCE=false
FRONTEND_MAINTENANCE_MESSAGE="Aktualizujemy sklep GPSwiss. Wrócimy najszybciej jak to możliwe."

GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_MODE=dry_run
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT=10

# Shipment label generation (DHL/DPD)
SHIPMENT_SENDER_NAME=
SHIPMENT_SENDER_ADDRESS=
SHIPMENT_SENDER_POSTAL_CODE=
SHIPMENT_SENDER_CITY=
SHIPMENT_SENDER_COUNTRY=PL
SHIPMENT_SENDER_CONTACT_NAME=GRZEGORZ PACIOREK
SHIPMENT_SENDER_PHONE=
SHIPMENT_SENDER_EMAIL=
DHL_API_ENDPOINT=
DHL_API_LOGIN=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=
DHL_DEFAULT_SERVICE=AH
DHL_TEST_MODE=true
DPD_API_ENDPOINT=
DPD_API_LOGIN=
DPD_API_PASSWORD=
DPD_ACCOUNT_NUMBER=
DPD_DEFAULT_SERVICE=CLASSIC
DPD_TEST_MODE=true

# Scheduled read-only Allegro/eBay order sync (local orders only)
GPS_MARKETPLACE_ORDER_SYNC_ENABLED=false
GPS_MARKETPLACE_ORDER_SYNC_LOOKBACK_DAYS=3
GPS_MARKETPLACE_ORDER_SYNC_CHANNELS=allegro,ebay

GPS_MARKETPLACE_FULFILLMENT_SYNC_ENABLED=false
GPS_MARKETPLACE_FULFILLMENT_WRITE_ENABLED=false

GPS_ALLEGRO_USER_AGENT="GPswiss/v1.0 (+https://gpswiss.pl/api-info)"

# Filament admin SPA-style Livewire navigation. Set false to restore classic full page loads.
FILAMENT_SPA_ENABLED=true
