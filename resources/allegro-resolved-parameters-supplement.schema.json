{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPSwiss Allegro parameter supplement — provenance candidate with schema freshness",
  "type": "object",
  "required": [
    "part_id",
    "allegro_category_id",
    "parameter_id",
    "parameter_name_snapshot",
    "parameter_type",
    "multiple_choices",
    "parameter_scope",
    "product_set_index",
    "values_ids",
    "values",
    "range_value",
    "raw_value",
    "required_snapshot",
    "required_for_product_snapshot",
    "describes_product_snapshot",
    "schema_snapshot_id",
    "source",
    "source_field",
    "source_listing_id",
    "marketplace_account_id",
    "captured_at",
    "source_observed_at",
    "completeness_status",
    "reason_code",
    "local_validation_status",
    "resolution_role",
    "candidate_id",
    "conflict_id",
    "valid_for_republication",
    "provenance",
    "schema_fetched_at",
    "schema_source_endpoint",
    "allegro_offer_id",
    "product_id",
    "unit",
    "fetched_at",
    "source_priority",
    "is_preferred",
    "historical_schema_mismatch",
    "association_conflict",
    "readback_unavailable"
  ],
  "properties": {
    "part_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allegro_category_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameter_name_snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameter_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "multiple_choices": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "parameter_scope": {
      "enum": [
        "offer",
        "product",
        null
      ]
    },
    "product_set_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "values_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "values": {
      "type": "array"
    },
    "range_value": {
      "type": [
        "object",
        "null"
      ]
    },
    "raw_value": {},
    "required_snapshot": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "required_for_product_snapshot": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "describes_product_snapshot": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "schema_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": [
        "manual_selection",
        "computed_from_part",
        "computed_from_car",
        "parameter_mapping",
        "legacy_offer_payload",
        "marketplace_listing_payload",
        "review_metadata",
        "unknown",
        "category_schema",
        "existing_allegro_offer"
      ]
    },
    "source_field": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_listing_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "marketplace_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "type": "string"
    },
    "source_observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completeness_status": {
      "enum": [
        "complete",
        "partial",
        "historical_only",
        "schema_unknown",
        "conflict"
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "local_validation_status": {
      "enum": [
        "unknown",
        "parameter_not_in_local_schema",
        "value_present_in_local_schema",
        "value_missing_or_invalid_locally"
      ]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conflict_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_for_republication": {
      "const": null
    },
    "resolution_role": {
      "enum": [
        "stored_source",
        "builder_result",
        "stored_source_and_builder_result",
        "coverage_marker"
      ]
    },
    "provenance": {
      "enum": [
        "manual_selection",
        "existing_listing",
        "local_mapping",
        "derived_from_part",
        "derived_from_car",
        "category_schema",
        "unresolved",
        "existing_allegro_offer"
      ]
    },
    "schema_fetched_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_source_endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "allegro_offer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "unit": {},
    "fetched_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_priority": {
      "type": "integer"
    },
    "is_preferred": {
      "type": "boolean"
    },
    "historical_schema_mismatch": {
      "type": "boolean"
    },
    "association_conflict": {
      "type": "boolean"
    },
    "readback_unavailable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
