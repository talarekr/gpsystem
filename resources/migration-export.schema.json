{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gpswiss:wystawczesc:products:1",
  "title": "products.json; manifest.json carries snapshot and safety flags",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "sku",
      "name",
      "part_number",
      "additional_part_codes",
      "quality",
      "part_position",
      "local_car_id",
      "ovoko_car_id",
      "price",
      "currency",
      "allegro_price",
      "ovoko_price",
      "ebay_price",
      "allegro_shipping_rate_name",
      "allegro_parameters",
      "offers",
      "images"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "sku": {
        "type": [
          "string",
          "null"
        ]
      },
      "price": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^-?[0-9]+[.][0-9]{2}$"
      },
      "currency": {
        "type": "string"
      },
      "additional_part_codes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "allegro_parameters": {
        "type": "array"
      },
      "offers": {
        "type": "array"
      },
      "images": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "image_id",
            "part_id",
            "package_path",
            "original_filename",
            "sort_order",
            "is_primary",
            "status",
            "bytes",
            "sha256"
          ]
        }
      }
    }
  }
}
